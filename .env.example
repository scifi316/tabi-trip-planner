# Copy to .env (or set in docker-compose.yml)
PORT=8080
DATA_DIR=./data
# Behind a reverse proxy (Caddy, Cloudflare Tunnel, Tailscale Serve)? Trust X-Forwarded-For for rate limiting.
TRUST_PROXY=false
# Use your own map styles (e.g. a self-hosted Protomaps/OpenFreeMap instance)
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# Max tiles fetched per "Save maps" press (OpenFreeMap asks for <= 3000)
# OFFLINE_TILE_LIMIT=3000
