# ---- Basics ----
PORT=8080
DATA_DIR=./data
# Behind Cloudflare Tunnel / Caddy / Tailscale: trust forwarded headers (real client IP, https).
TRUST_PROXY=false

# ---- Private link ----
# With a key set, the site answers "Not found" unless the visitor opened https://your-domain/?key=<ACCESS_KEY>
# once on that device. Generate one with:  openssl rand -base64 24
ACCESS_KEY=

# Developer console at https://your-domain/dev?devkey=<DEV_KEY> (open once per device).
# A view of every place, live locations and OwnTracks traffic, outbound calls and server logs. The key
# also gets its holder past the private link, so treat it like an admin password. Leave empty to turn it off.
DEV_KEY=
# Lets the console make a password reset link for anyone (for when the only admin is locked out).
# That can take over any account, so leave it off and turn it on only while you need it.
# DEV_RESET_LINKS=on

# Sessions last this many days of inactivity (sliding).
SESSION_DAYS=180

# ---- Cloudflare Tunnel ----
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > "Install connector". The app runs
# cloudflared itself (the Docker image includes it), and only on the node that is currently serving.
TUNNEL_TOKEN=

# ---- Storage for backups, receipts and failover (Cloudflare R2 or any S3-compatible store) ----
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=tabi/

# ---- High availability (set per machine; see docs/HOSTING.md) ----
# HA_MODE=on
# HA_NODE=do-sgp1           # a unique name per machine (deploy/setup.sh sets this)
# HA_PRIORITY=primary       # primary | backup

# ---- Maps ----
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# OFFLINE_TILE_LIMIT=3000

# ---- Notifications on the lock screen (Web Push) ----
# Nothing to set: Tabi makes its key pair once and keeps it in the database, so both servers share it.
# Only set these to use a key pair you made yourself (both machines need the same values).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   # defaults to the site's own https address

# ---- Picture a day ----
# PHOTO_LIMIT_MB=2048   # total space for the photos (R2's free tier is 10 GB); uploads stop with a message at this size

# ---- Group chat ----
# KLIPY_API_KEY=          # GIF search (free key: https://partner.klipy.com). Without it, GIFs can still be sent from phones.
# CHAT_MEDIA_LIMIT_MB=3072  # total space for chat photos and GIFs

# ---- Android app (docs/ANDROID.md) ----
# Nothing to set: uploading the APK in Settings publishes /.well-known/assetlinks.json.
# Only to publish a fingerprint without uploading an APK:
# ANDROID_PACKAGE=app.tabi.trip
# ANDROID_CERT_SHA256=AB:CD:...   # SHA-256 of the signing certificate
