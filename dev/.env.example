# Settings for the dev stack. Copy to dev/.env (which git ignores) and fill in what you want.
# Storage, failover and ports are set up by the stack itself; this file is only for extras.

# The private-link gate, as in production. Leave empty for no gate.
# ACCESS_KEY=dev-key

# GIF search in chat (free key: https://partner.klipy.com)
# KLIPY_API_KEY=

# The developer console (/dev) password
# DEV_KEY=dev

# A Cloudflare Tunnel of your own for a dev hostname (Zero Trust > Networks > Tunnels): its public
# hostname's service should be http://localhost:8080, like production's. The leader then runs
# cloudflared exactly as production does. Needs cloudflared installed for the native stack.
# TUNNEL_TOKEN=
